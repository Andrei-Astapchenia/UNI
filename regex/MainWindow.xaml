<Window x:Class="RegexHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Помощник проверки регулярных выражений"
        Height="720" Width="1100"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Регулярное выражение:" FontWeight="Bold" Margin="0,0,0,4"/>
        <TextBox Grid.Row="1" x:Name="ExpressionInput" FontFamily="Consolas" FontSize="14"
                 Margin="0,0,0,8" Text="\d{3}-\d{2}"/>

        <TextBlock Grid.Row="2" Text="Строка для поиска:" FontWeight="Bold" Margin="0,0,0,4"/>

        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>
            <RichTextBox Grid.Column="0" x:Name="TextInputArea"
                         FontFamily="Consolas" FontSize="14"
                         VerticalScrollBarVisibility="Auto"
                         AcceptsReturn="True"
                         Margin="0,0,8,0"/>

            <Border Grid.Column="1" BorderBrush="#CCC" BorderThickness="1"
                    Background="#F9F9F9" Padding="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="синтаксис для regex" FontWeight="Bold"
                                   FontSize="13" Margin="0,0,0,6"/>

                        <TextBlock TextWrapping="Wrap" FontFamily="Consolas" FontSize="12">
                            <Run FontWeight="Bold">abc</Run> — последовательность<LineBreak/>
                            <Run FontWeight="Bold">.</Run> — любой символ, кроме \n<LineBreak/>
                            <Run FontWeight="Bold">*</Run> — 0 или более<LineBreak/>
                            <Run FontWeight="Bold">+</Run> — 1 или более<LineBreak/>
                            <Run FontWeight="Bold">?</Run> — 0 или 1<LineBreak/>
                            <Run FontWeight="Bold">{n}</Run> — ровно n<LineBreak/>
                            <Run FontWeight="Bold">{n,}</Run> — не менее n<LineBreak/>
                            <Run FontWeight="Bold">{n,m}</Run> — от n до m<LineBreak/>
                            <LineBreak/>
                            <Run FontWeight="Bold">[...]</Run> — класс символов<LineBreak/>
                            <Run FontWeight="Bold">[a-z]</Run> — диапазон<LineBreak/>
                            <Run FontWeight="Bold">[^...]</Run> — отрицание<LineBreak/>
                            <LineBreak/>
                            <Run FontWeight="Bold">(...)</Run> — группировка<LineBreak/>
                            <Run FontWeight="Bold">A|B</Run> — альтернатива<LineBreak/>
                            <LineBreak/>
                            <Run FontWeight="Bold">\d</Run> — цифра<LineBreak/>
                            <Run FontWeight="Bold">\D</Run> — не цифра<LineBreak/>
                            <Run FontWeight="Bold">\w</Run> — буква/цифра/_<LineBreak/>
                            <Run FontWeight="Bold">\W</Run> — не \w<LineBreak/>
                            <Run FontWeight="Bold">\s</Run> — пробел/таб/перевод<LineBreak/>
                            <Run FontWeight="Bold">\S</Run> — не \s<LineBreak/>
                            <LineBreak/>
                            <Run FontWeight="Bold">\n \t \r</Run> — перевод строки / таб / CR<LineBreak/>
                            <Run FontWeight="Bold">\. \\ \+</Run> — экранирование<LineBreak/>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal">
            <Button x:Name="CheckButton" Content="Проверить"
                    Width="140" Height="34" Click="CheckButton_Click"/>
   
            <TextBlock x:Name="StatusLabel" VerticalAlignment="Center" Margin="16,0,0,0"
                       FontSize="13" Foreground="DimGray"/>
        </StackPanel>
    </Grid>
</Window>