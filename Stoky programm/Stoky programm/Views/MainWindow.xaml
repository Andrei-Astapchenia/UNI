<Window x:Class="Stoky_programm.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Stoky_programm"
        mc:Ignorable="d"
        Title="Stoky" Height="720" Width="1280" ResizeMode="NoResize" 
        WindowStyle="None" WindowStartupLocation="CenterScreen" Background="Transparent">

    <Border CornerRadius="25" Background="#08292b" >
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!--меню -->
            <Border Grid.Column="0" Background="#032029" CornerRadius="25 5 5 25" >
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" Color="Black" ShadowDepth="5"/>
                </Border.Effect>
                <StackPanel VerticalAlignment="Top" Margin="5,20,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,40">
                        <TextBlock Text="STOKY" FontSize="22" FontWeight="Bold" 
                                   Foreground="White" VerticalAlignment="Center" Margin="0,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                        <Button x:Name="MenuButtonInventory" Content="📦" 
                                ToolTip="Все объекты" Height="50" Width="50" Margin="0,5"
                                Background="Transparent" BorderThickness="0" Foreground="White"
                                Click="ButtonInventory_Click"/>
                        <Button x:Name="MenuCreateOrder" Content="🛒" 
                                ToolTip="Создать заказ" Height="50" Width="50" Margin="0,5"
                                Background="Transparent" BorderThickness="0" Foreground="White"
                                Click="ButtonCreateOrder_Click"/>
                        <Button x:Name="MenuOrders" Content="📋" 
                                ToolTip="Все заказы" Height="50" Width="50" Margin="0,5"
                                Background="Transparent" BorderThickness="0" Foreground="White"
                                Click="ButtonOrders_Click"/>
                        <Button x:Name="MenuAssets" Content="💼" 
                                ToolTip="Активы" Height="50" Width="50" Margin="0,5"
                                Background="Transparent" BorderThickness="0" Foreground="White"
                                Click="ButtonAssets_Click"/>
                    </StackPanel>
                    <Rectangle Height="1" Fill="#555" Margin="10,20,10,20" Opacity="0.6"/>
                    <StackPanel VerticalAlignment="Bottom" Margin="0,200,0,30">
                        <Button x:Name="MenuButtonExit" Content="Exit🚪" 
                                ToolTip="Выход" Height="40" Width="80" Margin="0,5"
                                Background="Transparent" BorderThickness="0" Foreground="White"
                                Click="ButtonExit_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            
            <Grid Grid.Column="1" Margin="30 20 5 0" Grid.RowSpan="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="Transparent" HorizontalAlignment="Left" 
                        Padding="0" CornerRadius="10" Margin="20 10 5 10">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" Color="Black" Opacity="0.2" ShadowDepth="5"/>
                    </Border.Effect>
                    <StackPanel x:Name="ButtonShowAll" Orientation="Horizontal">
                        <Button  Content="Все объекты" Background="#0d7851" BorderThickness="0"
                                Width="150" Height="60" 
                                Click="ButtonShowAll_Click"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ButtonShowProducts" Content="Продукты" Background="#1a7a6d" BorderThickness="0"
                                     Width="130" Height="50" Margin="40 10 0 0" 
                                    Click="ButtonShowProducts_Click"/>
                            <Button x:Name="ButtonAddProduct" Content="➕"
                                       ToolTip="Добавить продукт" Height="50" Width="50" Margin="0 10 0 0" 
                                       Background="Green" BorderThickness="0" Foreground="White"
                                       Click="ButtonAddProduct_Click"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ButtonShowAssets" Content="Активы" Background="#1a7a6d" BorderThickness="0"
                                      Width="130" Height="50" Margin="10 10 0 0" 
                                      Click="ButtonShowAssets_Click"/>
                            <Button x:Name="ButtonAddAsset" Content="➕" 
                                     ToolTip="Добавить актив" Height="50" Width="50" Margin="0 10 0 0" 
                                     Background="Purple" BorderThickness="0" Foreground="White"
                                     Click="ButtonAddAsset_Click" Cursor="Hand"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <!--вкладки-->
                <Grid Grid.Row="1"> <!--объекты-->
                    <Grid x:Name="AllObj" Visibility="Visible">
                        <Border Background="#1a62ab" CornerRadius="10" Margin="20 10 40 0" >
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" Color="Black" ShadowDepth="5"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="70"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="#edfff8" CornerRadius="25" Padding="10" Margin="5">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🔍 Поиск:" Foreground="Black" FontWeight="Bold" 
                                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBox x:Name="SearchTextBox" Width="500" Height="30" Foreground="Black" Background="Transparent"
                                                 FontSize="14" VerticalContentAlignment="Center"
                                                 TextChanged="SearchTextBox_TextChanged"/>
                                        <Button x:Name="ClearSearchButton" Content="❌" 
                                                BorderThickness="0" ToolTip="Очистить строку"
                                                Width="50" Height="50" Margin="0 0 0 0"
                                                Background="Transparent" Foreground="Gray"
                                                Click="ClearSearchButton_Click"/>
                                    </StackPanel>
                                </Border>
                                <DataGrid x:Name="Items" Grid.Row="1" Margin="5"
                                      AutoGenerateColumns="False"
                                      SelectionMode="Single"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      RowBackground="#edfff8"
                                      AlternatingRowBackground="White"
                                      BorderThickness="0"
                                      ColumnWidth="*"
                                      MouseDoubleClick="Items_MouseDoubleClick">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ID" Binding="{Binding ID}" Width="60"/>
                                        <DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="85"/>
                                        <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="180"/>
                                        <DataGridTextColumn Header="Производитель" Binding="{Binding Manufacturer}" Width="*"/>
                                        <DataGridTextColumn Header="Модель" Binding="{Binding Model}" Width="*"/>
                                        <DataGridTextColumn Header="Инв.№" Binding="{Binding InventoryNumber}" Width="90"/>
                                        <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="80"/>
                                        <DataGridTextColumn Header="Общая цена" Width="140">
                                            <DataGridTextColumn.Binding>
                                                <Binding Path="TotalPrice" StringFormat="{}{0:F2}"/>
                                            </DataGridTextColumn.Binding>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Добавлен" Width="100">
                                            <DataGridTextColumn.Binding>
                                                <Binding Path="AddedDate" StringFormat="{}{0:dd.MM.yyyy}"/>
                                            </DataGridTextColumn.Binding>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Статус" Width="105">
                                            <DataGridTextColumn.Binding>
                                                <Binding Path="ActiveStatusText"/>
                                            </DataGridTextColumn.Binding>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                    <!--создать заказ-->
                    <Grid x:Name="CreateOrder" Visibility="Collapsed">
                        <Border Background="#329c75" CornerRadius="10" Margin="20 10 40 0" Padding="5">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" Color="Black" ShadowDepth="5"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="100"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="auto"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Height="85" Background="#237557" CornerRadius="10">
                                    <StackPanel>
                                        <TextBlock Text="Создание нового заказа" Foreground="White" FontWeight="Bold" FontSize="22" Margin="15 5 10 0"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="О клиенте:" Foreground="White" FontSize="15" VerticalAlignment="Center" Margin="20 10 5 0"/>
                                            <TextBox x:Name="TextCustomerInfo" Width="900" Height="30" FontSize="16" Margin="0 10 0 0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="1" Height="220" Background="#0d4f3d" CornerRadius="10" Padding="10" Margin="0 0 0 10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Доступные товары" Foreground="White" FontWeight="Bold" Margin="20 0 0 10"/>
                                        <DataGrid x:Name="AvailableProducts" Grid.Row="1"
                                                  AutoGenerateColumns="False"
                                                  SelectionMode="Single"
                                                  IsReadOnly="True"
                                                  HeadersVisibility="Column">
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Header="" Width="80">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Button Content="➕" Padding="5 2" Height="30" Width="30"
                                                                    Click="ButtonAddProductToOrder_Click"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="Auto"/>
                                                <DataGridTextColumn Header="Производитель" Binding="{Binding Manufacturer}" Width="200"/>
                                                <DataGridTextColumn Header="Модель" Binding="{Binding Model}" Width="*">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="HorizontalAlignment" Value="Left" />
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="80"/>
                                                <DataGridTextColumn Header="Цена за ед."  Width="120">
                                                    <DataGridTextColumn.Binding>
                                                        <Binding Path="PricePerUnit" StringFormat="{}{0:F2}"/>
                                                    </DataGridTextColumn.Binding>
                                                </DataGridTextColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="2" Height="205" Background="#073025" CornerRadius="10" Padding="10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Товары в заказе" Foreground="White" FontWeight="Bold" Margin="20 0 0 10"/>
                                        <DataGrid x:Name="OrderedItems" Grid.Row="1"
                                                  AutoGenerateColumns="False"
                                                  SelectionMode="Single"
                                                  HeadersVisibility="Column">       
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Header="" Width="80">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Button Content="⨉" Padding="5 2" Background="Transparent" 
                                                                    Foreground="Red" BorderBrush="Red" Height="30" Width="30"
                                                                    Click="ButtonDeleteProductFromOrder_Click">
                                                            <Button.Style>
                                                                <Style TargetType="Button">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Product}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                            </Button>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTextColumn Header="Название"  Width="Auto" IsReadOnly="True">
                                                    <DataGridTextColumn.Binding>
                                                        <Binding Path="Product.Name" />
                                                    </DataGridTextColumn.Binding>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Header="Производитель" Width="Auto" IsReadOnly="True">
                                                    <DataGridTextColumn.Binding>
                                                        <Binding Path="Product.Manufacturer"/>
                                                    </DataGridTextColumn.Binding>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Header="Модель" Width="*">
                                                    <DataGridTextColumn.Binding>
                                                        <Binding Path="Product.Model"/>
                                                    </DataGridTextColumn.Binding>
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="HorizontalAlignment" Value="Left" />
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                    <DataGridTextColumn Header="Кол-во" Binding="{Binding OrderQuantity}" Width="90"/>
                                                <DataGridTextColumn Header="Цена за ед."  Width="Auto" IsReadOnly="True">
                                                    <DataGridTextColumn.Binding>
                                                        <Binding Path="Product.PricePerUnit" StringFormat="{}{0:F2}"/>
                                                    </DataGridTextColumn.Binding>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Header="Итого"  Width="150" IsReadOnly="True">
                                                    <DataGridTextColumn.Binding>
                                                        <Binding Path="TotalPrice" StringFormat="{}{0:F2}"/>
                                                    </DataGridTextColumn.Binding>
                                                </DataGridTextColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <Border Grid.Row="2" Background="#fbd6ff" CornerRadius="10" Padding="10" Margin="0 10 0 0">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock x:Name="TotalOrderText" FontWeight="Bold" FontSize="16"
                                                           VerticalAlignment="Center" Margin="10 0" Foreground="Green"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                    <!--Заказы-->
                    <Grid x:Name="AllOrders" Visibility="Collapsed">
                        <Border Background="#1da875" CornerRadius="10" Margin="20 10 40 0" Padding="0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" Color="Black" ShadowDepth="5"/>
                            </Border.Effect>
                            <DataGrid x:Name="Orders" Margin="5" 
                                      AutoGenerateColumns="False"
                                      SelectionMode="Single"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      RowBackground="White"
                                      AlternatingRowBackground="#F5F5F5"
                                      BorderThickness="0"
                                      ColumnWidth="*">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="№" Binding="{Binding OrderNumber}" Width="80"/>
                                    <DataGridTextColumn Header="Дата" Width="100">
                                        <DataGridTextColumn.Binding>
                                            <Binding Path="OrderDate" StringFormat="{}{0:dd.MM.yyyy}"/>
                                        </DataGridTextColumn.Binding>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Получатель" Binding="{Binding CustomerInfo}" Width="*"/>
                                    <DataGridTextColumn Header="Статус" Binding="{Binding StatusDisplay}" Width="120"/>
                                    <DataGridTextColumn Header="Товаров" Width="120">
                                        <DataGridTextColumn.Binding>
                                            <Binding Path="TotalItemsCount"/>
                                        </DataGridTextColumn.Binding>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Сумма" Width="240">
                                        <DataGridTextColumn.Binding>
                                            <Binding Path="TotalAmount" StringFormat="{}{0:F2}"/>
                                        </DataGridTextColumn.Binding>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>

                    <!--Активы -->
                    <Grid x:Name="AllAssets" Visibility="Collapsed">
                        <Border Background="#6d187d" CornerRadius="10" Margin="20 10 40 0" Padding="5">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" Color="Black" ShadowDepth="5"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="#4a1256" CornerRadius="5" Padding="10" Margin="0 0 0 10">
                                    <TextBlock Text="Активы предприятия " Foreground="White" FontWeight="Bold" FontSize="16"/>
                                </Border>
                                <DataGrid x:Name="Assets" Grid.Row="1"
                                          AutoGenerateColumns="False"
                                          SelectionMode="Single"
                                          IsReadOnly="True"
                                          HeadersVisibility="Column">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="Auto"/>
                                        <DataGridTextColumn Header="Тип" Binding="{Binding AssetTypeDisplay}" Width="130"/>
                                        <DataGridTextColumn Header="Состояние" Width="150" IsReadOnly="True">
                                            <DataGridTextColumn.CellStyle>
                                                <Style TargetType="DataGridCell">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Condition}" Value="Damaged">
                                                            <Setter Property="Foreground" Value="Orange"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Condition}" Value="Broken">
                                                            <Setter Property="Foreground" Value="Red"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DataGridTextColumn.CellStyle>
                                            <DataGridTextColumn.Binding>
                                                <Binding Path="ConditionDisplay"/>
                                            </DataGridTextColumn.Binding>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Инв. номер" Binding="{Binding InventoryNumber}" Width="140"/>
                                        <DataGridTextColumn Header="Дата ввода" Width="120">
                                            <DataGridTextColumn.Binding>
                                                <Binding Path="CommissioningDate" StringFormat="{}{0:dd.MM.yyyy}"/>
                                            </DataGridTextColumn.Binding>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Статус обслуживания" Width="200">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Condition}" Value="Damaged">
                                                            <Setter Property="Text" Value="Требует ремонта"/>
                                                            <Setter Property="Foreground" Value="Orange"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding NeedsServiceDisplay}" Value="True">
                                                            <Setter Property="Text" Value="Требует обслуживания"/>
                                                            <Setter Property="Foreground" Value="Black"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!--низ-->
                <Border Grid.Row="2" Background="White" CornerRadius="10" Margin="10" Padding="10">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" Color="Black" ShadowDepth="5"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel x:Name="PanelAllObjButtons" Orientation="Horizontal">
                            <Button x:Name="ButtonDetails" Content="Подробнее" Background="#1a7a6d"
                                    Width="100" Height="35" Click="ButtonDetails_Click"/>
                            <Button x:Name="ButtonDelete" Content="Удалить" Background="#1a7a6d"
                                    Width="100" Height="35" Margin="10,0,0,0" Click="ButtonDelete_Click"/>
                        </StackPanel>

                        <StackPanel x:Name="PanelCreateOrderButtons" Orientation="Horizontal" Visibility="Collapsed">
                            <Button x:Name="ButtonClearOrder" Content="Очистить"  Background="#1a7a6d"
                                    Width="100" Height="35" Click="ButtonClearOrder_Click"/>
                            <Button x:Name="ButtonConfirmOrder" Content="Подтвердить заказ"  Background="#1a7a6d"
                                    Width="120" Height="35" Margin="10,0,0,0" Click="ButtonConfirmOrder_Click"/>
                        </StackPanel>
                        <StackPanel x:Name="PanelAllAssetsButtons" Orientation="Horizontal" HorizontalAlignment="Center" Visibility="Collapsed">
                            <Button x:Name="ButtonAssetDetails" Content="📋 Подробнее" 
                                    Background="#1a7a6d" Foreground="White"
                                    Width="120" Height="35" Margin="0 0 10 0" 
                                    Click="ButtonAssetDetails_Click"/>
                            <Button x:Name="ButtonRepairAsset" Content="🔧 Обслужить/Ремонтировать" 
                                    Background="#FF9800" Foreground="White"
                                    Width="240" Height="35" Margin="0 0 10 0"
                                    Click="ButtonRepairAsset_Click"/>
                            <Button x:Name="ButtonDeleteAsset" Content="🗑️ Удалить" 
                                    Background="#F44336" Foreground="White"
                                    Width="110" Height="35"
                                    Click="ButtonDeleteAsset_Click"/>
                        </StackPanel>
                        <StackPanel x:Name="PanelAllOrdersButtons" Orientation="Horizontal" Visibility="Collapsed">
                            <Button x:Name="ButtonViewOrderDetails" Content="Просмотр"  Background="#1a7a6d"
                                    Width="100" Height="35" Click="ButtonViewOrderDetails_Click"/>
                            <Button x:Name="ButtonCancelSelectedOrder" Content="Отменить"  Background="#1a7a6d"
                                    Width="100" Height="35" Margin="10,0,0,0" Click="ButtonCancelSelectedOrder_Click"/>
                            <Button x:Name="ButtonCompleteSelectedOrder" Content="Завершить"  Background="#1a7a6d"
                                    Width="100" Height="35" Margin="10,0,0,0" Click="ButtonCompleteSelectedOrder_Click"/>
                            <Button x:Name="ButtonDeleteOrder" Content="Удалить" Background="Red"
                                    Width="100" Height="35" Margin="10,0,0,0" Click="ButtonDeleteOrder_Click"/>
                        </StackPanel>

                        <TextBlock x:Name="TableStatus" Margin="20,0,0,0" 
                                   VerticalAlignment="Center" FontSize="12"
                                   TextWrapping="Wrap" MinWidth="200"/>
                    </StackPanel>
                </Border> 
            </Grid>
        </Grid>
    </Border>
</Window> 
