<Window x:Class="Stoky_programm.Windows.WindowAddAsset"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Добавление актива" Height="550" Width="450"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" Background="Transparent">

    <Border CornerRadius="15" Background="#08292b" Margin="8,10,12,10" MouseDown="Border_MouseDown">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#032029" CornerRadius="10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Добавление нового актива" 
                               Foreground="White" FontSize="18" FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            
            <Border Grid.Row="1" Background="#6d187d" CornerRadius="10" Padding="15">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Label Content="Название актива:" Foreground="White" FontWeight="Bold"/>
                        <TextBox x:Name="txtName" Height="30" Margin="0,0,0,10" FontSize="14" Foreground="White"/>

                        <Label Content="Тип актива:" Foreground="White" FontWeight="Bold"/>
                        <ComboBox x:Name="cmbAssetType" Height="30" Margin="0,0,0,10" FontSize="14" Foreground="White"/>

                        <Label Content="Состояние:" Foreground="White" FontWeight="Bold"/>
                        <ComboBox x:Name="cmbCondition" Height="30" Margin="0,0,0,10" FontSize="14" />

                        <Label Content="Инвентарный номер:" Foreground="White" FontWeight="Bold"/>
                        <TextBox x:Name="txtInventoryNumber" Height="30" Margin="0,0,0,10" FontSize="14" Foreground="White"/>
                        
                        <Label Content="Цена (руб.):" Foreground="White" FontWeight="Bold"/>
                        <TextBox x:Name="txtPrice" Height="30" Margin="0,0,0,10" FontSize="14"  Foreground="White"/>

                        <Label Content="Дата ввода в эксплуатацию:" Foreground="White" FontWeight="Bold"/>
                        <DatePicker x:Name="dpCommissioningDate" Height="30" Margin="0,0,0,15 " Foreground="White"
                                    SelectedDate="{x:Static sys:DateTime.Today}" FontSize="14" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Кнопки -->
            <Border Grid.Row="2" Background="#032029" CornerRadius="10" Padding="10" Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Отмена" Width="100" Height="35" 
                            Background="#1a7a6d" Foreground="White" FontWeight="Bold"
                            Margin="0,0,10,0" Click="ButtonCancel_Click"/>
                    <Button Content="Добавить" Width="100" Height="35" 
                            Background="#0d7851" Foreground="White" FontWeight="Bold"
                            Click="ButtonAdd_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>