<Window x:Class="Stoky_programm.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Stoky_programm"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="Stoky - учет ценностей" Height="800" Width="1200" WindowStyle="ThreeDBorderWindow" FontSize="14">
    <StackPanel Margin="25">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="400"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5">
                <Button x:Name="BottonAddProduct" Content="Добавить продукт" 
                     Width="120" Height="50" Margin="100,0,0,0" Click="BottonAddProduct_Click"/>
                <Button x:Name="BottonAddAsset" Content="Добавить актив" 
                    Width="120" Height="50" Margin="0" Click="BottonAddAsset_Click"/>
                <Button x:Name="BottonShowAll" Content="Все объекты" 
                    Width="100" Height="50" Margin="0" Click="BottonShowAll_Click"/>
                <Button x:Name="BottonShowProducts" Content="Продукты" 
                    Width="100" Height="50" Margin="0" Click="BottonShowProducts_Click"/>
                <Button x:Name="BottonShowAssets" Content="Активы" 
                    Width="100" Height="50" Margin="0" Click="BottonShowAssets_Click"/>
            </StackPanel>

            <DataGrid x:Name="Items" Grid.Row="1" Margin="20"
                  AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding ID}" Width="70"/>
                    <DataGridTextColumn Header="Тип" Width="200">
                        <DataGridTextColumn.Binding>
                            <MultiBinding StringFormat="{}{0}">
                                <Binding Path="GetType().Name"/>
                            </MultiBinding>
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="300"/>
                    <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="80"/>
                    <DataGridTextColumn Header="Цена" Binding="{Binding TotalPrice}" Width="100"/>
                    <DataGridTextColumn Header="Дата добавления" Binding="{Binding TotalPrice}" Width="200"/>
                    <DataGridCheckBoxColumn Header="Активен" Binding="{Binding IsActive}" Width="70"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="10">
                <Button x:Name="BottonDetails" Content="Подробнее" Width="100" Margin="5" Click="BottonDetails_Click"/>
                <Button x:Name="BottonDelete" Content="Удалить" Width="100" Margin="5" Click="BottonDelete_Click"/>
                <TextBlock x:Name="TblStatus" Margin="10" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>